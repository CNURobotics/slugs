[INPUT]
r
p
q

[OUTPUT]
hold
trig

[ENV_INIT]
## gate_r: r starts false
! r
## gate_p: p starts false
! p

[SYS_INIT]
1

[ENV_TRANS]
## gate_r_safety: r stays false forever
! r'
## holdFreezeFalse: holding at !p keeps p false
| ! hold | p ! p'
## holdFreezeTrue: holding at p keeps p true
| ! hold | ! p p'
## decoyTrue: if r and trig, q must become true
| ! r | ! trig q'
## decoyFalse: if r and trig, q must become false
| ! r | ! trig ! q'

[SYS_TRANS]
1

[ENV_LIVENESS]
## visitP
p

[SYS_LIVENESS]
1
